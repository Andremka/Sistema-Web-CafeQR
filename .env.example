APP_NAME=CafeQR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------------- CORREO ----------------
# MAIL_MAILER=log  -> los correos NO salen (solo se guardan en storage/logs/laravel.log). Sirve para probar sin internet.
# MAIL_MAILER=smtp -> salen de verdad (configura Gmail abajo).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@gmail.com
# Contraseña de APLICACIÓN de Google (16 letras, sin espacios). NO es tu contraseña normal.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tucorreo@gmail.com
MAIL_FROM_NAME="CafeQR"

# ---------------- CAFEQR ----------------
# Dominio(s) permitidos para registrarse (separados por coma)
DOMINIO_INSTITUCIONAL=univalle.edu

# demo  = el QR abre una página de pago de prueba desde el celular (misma red WiFi que la PC)
# banco = el QR es tu QR real del banco (Yape, etc.) en public/img/qr-cobro.png y Caja confirma el pago
PAGO_MODO=demo
PAGO_MINUTOS=30
CAFEQR_URL_PUBLICA=
TIEMPO_PREPARACION=10

# Administrador (se crea con: php artisan migrate --seed). CÁMBIALE la contraseña.
ADMIN_NOMBRE="Administrador CafeQR"
ADMIN_EMAIL=bmj2031702@est.univalle.edu
ADMIN_PASSWORD=Admin12345
